{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VeriPactBenchmarkScenario",
  "type": "object",
  "required": ["scenarioId", "group", "htmlFile", "expected"],
  "properties": {
    "scenarioId": { "type": "string", "pattern": "^(benign|drift|adv)_[0-9]{2}$" },
    "group": { "type": "string", "enum": ["benign", "drift", "adversarial"] },
    "htmlFile": { "type": "string", "description": "Synthetic storefront HTML fixture filename." },
    "mandateId": { "type": "string", "description": "Mandate from .veripact/mandates.json (default: first)." },
    "expected": {
      "type": "object",
      "required": ["gate", "verdict"],
      "properties": {
        "gate": { "type": "string", "enum": ["PROCEED", "ASK_HUMAN_DELTA", "BLOCK"] },
        "verdict": {
          "type": ["string", "null"],
          "enum": ["BUYER_FORGERY_DETECTED", "MERCHANT_DRIFT_CONFIRMED", "TERMS_HONORED", null]
        }
      }
    }
  }
}
