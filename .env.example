# VeriPact environment — copy to .env and fill in. NEVER commit .env.
# Key boundaries (AGENTS.md Rule 2): each key is readable ONLY by its boundary.

# Rung 1 — buyer boundary ONLY (packages: buyer route, term-extractor inputs)
BUYER_ED25519_PRIVATE_KEY=

# Rung 2 — witness boundary ONLY (packages: witness-client, witness route)
WITNESS_ED25519_PRIVATE_KEY=
CHANNEL3_API_KEY=

# Rung 3 — merchant boundary ONLY (packages: paypal-client, merchant route)
MERCHANT_ED25519_PRIVATE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox-only host. The client refuses any other host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Demo / deploy (no secrets)
PUBLIC_STORE_BASE_URL=http://localhost:3000
PORT=3000
AG_STUDIO_LICENSE_KEY=
