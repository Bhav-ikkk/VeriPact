{
  "name": "veripact",
  "version": "0.1.0",
  "private": true,
  "description": "VeriPact: prove what the merchant promised. Spectra-style TypeScript monorepo foundation.",
  "type": "commonjs",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b .",
    "clean": "tsc -b --clean .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "tsc -b . && vitest run",
    "format": "prettier --write .",
    "start": "node packages/workbench/dist/index.js",
    "regression": "tsc -b . && tsc -p scripts/tsconfig.json && node scripts/dist/run-regression.js",
    "seed:sandbox": "tsc -b . && tsc -p scripts/tsconfig.json && node scripts/dist/seed-live-sandbox.js",
    "assets:generate": "tsc -b . && tsc -p scripts/tsconfig.json && node scripts/dist/generate-visual-assets.js",
    "demo:record": "tsc -b . && tsc -p scripts/tsconfig.json && node scripts/dist/playwright-record-demo.js",
    "verify:e2e": "tsc -b . && tsc -p scripts/tsconfig.json && node scripts/dist/verify-ui-e2e.js",
    "verify:live": "tsc -p scripts/tsconfig.json && node scripts/dist/verify-live-url.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
